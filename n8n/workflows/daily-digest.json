            {
              "id": "5f0c1a52-8d0e-4c8e-9a51-1e6f2b7c0a03",
              "leftValue": "={{ $json.title }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
