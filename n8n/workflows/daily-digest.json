      "id": "5f0c1a52-8d0e-4c8e-9a51-1e6f2b7c0a01",
      "name": "Every day at 08:30"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Best scored jobs first seen in the last 24 hours, using each job's latest score.\nWITH latest AS (\n    SELECT DISTINCT ON (job_id) job_id, score, fit, reasons\n    FROM scores\n    ORDER BY job_id, scored_at DESC\n)\nSELECT j.id, j.title, j.company, j.location, j.url,\n       l.score, l.fit, l.reasons,\n       -- Window function: counted before LIMIT, so it is the total of new jobs.\n       count(*) OVER () AS new_jobs\nFROM jobs j\nJOIN latest l ON l.job_id = j.id\nWHERE j.first_seen_at >= now() - interval '24 hours'\nORDER BY l.score DESC\nLIMIT 5;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "id": "5f0c1a52-8d0e-4c8e-9a51-1e6f2b7c0a02",
      "name": "Top new jobs",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "Postgres Radar (read-only)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
