      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "id": "5f0c1a52-8d0e-4c8e-9a51-1e6f2b7c0a04",
      "name": "Any new jobs?"
    },
    {
      "parameters": {
        "jsCode": "// Joins every job the query returned into one Telegram message (HTML).\nconst escape = (text) => String(text ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\nconst fitIcon = { high: '🟢', medium: '🟡', low: '🔴' };\nconst shorten = (text, max) => (text.length > max ? text.slice(0, max) + '…' : text);\n\nconst jobs = $input.all().map((item) => item.json);\n\nconst lines = jobs.map((job, i) =>\n  `${i + 1}. ${fitIcon[job.fit] ?? '⚪'} <b>${job.score}</b> · <a href=\"${escape(job.url)}\">${escape(job.title)}</a>\\n` +\n  `${escape(job.company)} · ${escape(job.location || 'no location')}\\n` +\n  `<i>${escape(shorten(job.reasons, 160))}</i>`\n);\n\nconst header = `🔎 <b>Radar</b> · top ${jobs.length} of ${jobs[0].new_jobs} new jobs`;\nreturn [{ json: { text: [header, ...lines].join('\\n\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -96
      ],
      "id": "5f0c1a52-8d0e-4c8e-9a51-1e6f2b7c0a05",
      "name": "Format digest"
    },
