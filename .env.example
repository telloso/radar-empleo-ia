# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# n8n (encrypts stored credentials; generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Read-only Postgres role n8n uses to read jobs and scores
# (generate with: openssl rand -hex 24)
N8N_READER_PASSWORD=

# Telegram chat the n8n bot writes to; n8n/workflows.py puts it into the
# workflows on import (get it from https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_CHAT_ID=

# Jooble API key (free, request it at https://es.jooble.org/api/about)
JOOBLE_API_KEY=

# Claude API key for the scorer (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
